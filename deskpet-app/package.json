{
  "name": "maibot-deskpet",
  "version": "1.0.5",
  "description": "MaiBot 桌面宠物 - Live2D Deskpet",
  "author": "Maboroshinatsu",
  "license": "MIT",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "test": "node --test tests/services.test.cjs tests/ptt.test.cjs tests/voice-input.test.cjs tests/imageset.test.cjs",
    "test:host": "node --test tests/maibot-protocol.test.cjs tests/host-controller.test.cjs tests/fake-host.test.cjs tests/host-boundary.test.cjs",
    "test:model-lifecycle": "node --test tests/probe-guard.test.cjs tests/live2d-loader.test.cjs tests/motion-priority.test.cjs tests/expression-ownership.test.cjs",
    "test:runtime-trust": "node --test tests/runtime-policy.test.cjs tests/runtime-approval.test.cjs tests/runtime-confirmation.test.cjs tests/runtime-transport.test.cjs",
    "test:no-mic": "npm run test:host && npm run test:model-lifecycle && npm run test:runtime-trust && node --test tests/imageset.test.cjs",
    "test:plugin-lifecycle": "python -B ../tests/test_plugin_lifecycle.py",
    "test:watchdog": "python -B watchdog_selftest.py",
    "test:runtime-services": "node --test tests/runtime-services.cjs",
    "test:runtime-ui": "electron runtime-ui.cjs",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "dist": "electron-vite build && electron-builder --win nsis"
  },
  "dependencies": {
    "@pixi/app": "^6.5.10",
    "@pixi/core": "^6.5.10",
    "@pixi/display": "^6.5.10",
    "@pixi/extensions": "^6.5.10",
    "@pixi/ticker": "^6.5.10",
    "pinia": "^2.3.0",
    "pixi-live2d-display": "^0.4.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.0",
    "electron": "^34.5.8",
    "electron-builder": "^26.15.3",
    "electron-vite": "^2.3.0",
    "typescript": "^5.7.0",
    "vue-tsc": "^2.2.0"
  }
}
